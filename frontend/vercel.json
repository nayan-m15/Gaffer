{
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://gaffer-api-ynaf.onrender.com/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://gaffer-api-ynaf.onrender.com/:path*"
    },
    {
      "source": "/terms-of-service.html",
      "destination": "/terms-of-service.html"
    },
    {
      "source": "/privacy-policy.html",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
