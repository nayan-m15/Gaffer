# Neon/PostgreSQL connection string. Keep the real value in an uncommitted .env.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
TEST_DATABASE_URL=postgresql://user:password@host/separate_test_database?sslmode=require
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Backend's own base URL, used by Better Auth for cookies/callbacks.
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
FRONTEND_URL=http://localhost:5173
# Brevo transactional email (verification emails). Leave BREVO_API_KEY unset
# locally to log verification links to the console instead of sending them.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=SportCoachingTool
