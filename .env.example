# Neon/PostgreSQL connection string. Keep the real value in an uncommitted .env.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
TEST_DATABASE_URL=postgresql://user:password@host/separate_test_database?sslmode=require
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin that serves /auth. In production this must be the Vercel app
# origin (for example https://gaffer-virid.vercel.app), because Vercel proxies
# /auth to Render and the OAuth cookie and callback must use the same host.
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
FRONTEND_URL=http://localhost:5173
# Brevo transactional email (verification emails). Leave BREVO_API_KEY unset
# locally to log verification links to the console instead of sending them.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=SportCoachingTool
# Optional provider overrides: defaults use Open-Meteo's non-commercial endpoints.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_CACHE_MINUTES=30
WEATHER_HISTORY_DAYS=5
WEATHER_FORECAST_DAYS=16
# PowerSync Cloud/self-hosted endpoint and development HS256 key. Use an
# asymmetric JWKS signing key before production deployment.
POWERSYNC_URL=
POWERSYNC_KID=gaffer-dev
POWERSYNC_SHARED_SECRET=
# Production: set a PKCS#8 RSA private key (newlines may be written as \\n),
# configure PowerSync to read /sync/jwks, then remove the shared secret.
POWERSYNC_PRIVATE_KEY=
VITE_POWERSYNC_URL=
VITE_DEPLOYMENT_ENV=local
# Operational rollout controls. Leave the allowlist empty to enable every
# match. Disabled-match uploads remain dependency-pending and retry later.
OFFLINE_SYNC_ENABLED=true
OFFLINE_SYNC_MATCH_IDS=
# Protects GET /health/operations. Use a separate high-entropy production value.
OPERATIONS_HEALTH_TOKEN=
