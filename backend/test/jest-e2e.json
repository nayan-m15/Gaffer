{
  "moduleFileExtensions": ["js", "json", "ts", "mjs"],
  "rootDir": ".",
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/setup-isolated-db.ts"],
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "\\.(m|c)?js$": ["babel-jest", { "configFile": "./test/babel.config.cjs" }]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(?:better-auth|@better-auth|@better-fetch|@noble|better-call|jose|kysely|nanostores|rou3)/)"
  ],
  "testTimeout": 60000
}
