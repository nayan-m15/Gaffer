{
  "moduleFileExtensions": ["js", "json", "ts", "mjs"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "\\.(m|c)?js$": ["babel-jest", { "configFile": "./test/babel.config.cjs" }]
  },
  "transformIgnorePatterns": [],
  "testTimeout": 20000
}
